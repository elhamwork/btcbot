# Copy to .env and fill in if/when running against real APIs from a network
# environment that can actually reach them (this project's own dev environment
# could not -- see README.md "Data Sources & Limitations").

# Kalshi API credentials (only needed for endpoints that require auth, e.g.
# private account/order endpoints; historical market/trade data is documented
# as public/no-auth in Kalshi's docs, but could not be verified live here).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Alpha Vantage API key (used via the Alpha Vantage MCP server in this
# project's actual run; set this if calling the Alpha Vantage REST API directly
# instead). Free-tier keys do NOT unlock CRYPTO_INTRADAY / TIME_SERIES_INTRADAY
# (confirmed premium-gated during this project's research -- see README).
ALPHAVANTAGE_API_KEY=

# Overrides config.py's default data mode. "synthetic_demo" (default) or
# "real_daily_only".
BTCBOT_DATA_MODE=synthetic_demo
